rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helpers
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'client', 'budgetTotal', 'spentTotal', 'status', 'ownerId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 64 &&
        data.name is string && data.name.size() <= 200 &&
        data.client is string && data.client.size() <= 200 &&
        data.budgetTotal is number &&
        data.spentTotal is number &&
        data.status in ['En Ejecución', 'Planificación', 'Finalizado', 'Suspendido'] &&
        data.ownerId == request.auth.uid;
    }

    function isValidFieldVisit(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'date', 'foremanName', 'status', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.projectName is string && data.projectName.size() <= 200 &&
        data.date is string && data.date.size() <= 30 &&
        data.foremanName is string && data.foremanName.size() <= 150 &&
        data.status in ['Autorizado', 'Pendiente', 'Revisión'] &&
        data.authorId == request.auth.uid;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'projectId', 'date', 'category', 'amount', 'currency', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.category is string && data.category.size() <= 100 &&
        data.amount is number &&
        data.currency in ['GTQ', 'USD'] &&
        data.authorId == request.auth.uid;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'projectId', 'date', 'employeeId', 'employeeName', 'status', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.employeeId is string && data.employeeId.size() <= 128 &&
        data.employeeName is string && data.employeeName.size() <= 150 &&
        data.status in ['Presente', 'Ausente', 'Permiso', 'Incapacidad IGSS'] &&
        data.authorId == request.auth.uid;
    }

    function isValidCompanySettings(data) {
      return data.keys().hasAll(['legalName', 'commercialName', 'ownerId']) &&
        data.legalName is string && data.legalName.size() <= 250 &&
        data.commercialName is string && data.commercialName.size() <= 250 &&
        data.ownerId == request.auth.uid;
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && (existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(projectId) && isSignedIn() && isValidProject(incoming());
      allow update: if isValidId(projectId) && isSignedIn() &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        isValidProject(incoming());
      allow delete: if isValidId(projectId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // Field visits collection
    match /fieldVisits/{visitId} {
      allow get: if isSignedIn() && (existing().authorId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.authorId == request.auth.uid);
      allow create: if isValidId(visitId) && isSignedIn() && isValidFieldVisit(incoming());
      allow update: if isValidId(visitId) && isSignedIn() &&
        existing().authorId == request.auth.uid &&
        incoming().authorId == existing().authorId &&
        isValidFieldVisit(incoming());
      allow delete: if isValidId(visitId) && isSignedIn() && existing().authorId == request.auth.uid;
    }

    // Expenses collection
    match /expenses/{expenseId} {
      allow get: if isSignedIn() && (existing().authorId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.authorId == request.auth.uid);
      allow create: if isValidId(expenseId) && isSignedIn() && isValidExpense(incoming());
      allow update: if isValidId(expenseId) && isSignedIn() &&
        existing().authorId == request.auth.uid &&
        incoming().authorId == existing().authorId &&
        isValidExpense(incoming());
      allow delete: if isValidId(expenseId) && isSignedIn() && existing().authorId == request.auth.uid;
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (existing().authorId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.authorId == request.auth.uid);
      allow create: if isValidId(attendanceId) && isSignedIn() && isValidAttendance(incoming());
      allow update: if isValidId(attendanceId) && isSignedIn() &&
        existing().authorId == request.auth.uid &&
        incoming().authorId == existing().authorId &&
        isValidAttendance(incoming());
      allow delete: if isValidId(attendanceId) && isSignedIn() && existing().authorId == request.auth.uid;
    }

    // Company Settings collection
    match /companySettings/{settingId} {
      allow get: if isSignedIn() && (existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(settingId) && isSignedIn() && isValidCompanySettings(incoming());
      allow update: if isValidId(settingId) && isSignedIn() &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        isValidCompanySettings(incoming());
      allow delete: if isValidId(settingId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // Machinery collection
    match /machinery/{machineryId} {
      allow get, list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(machineryId) && isSignedIn() && (incoming().authorId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isValidId(machineryId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow delete: if isValidId(machineryId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
    }

    // Machinery Logs collection
    match /machineryLogs/{logId} {
      allow get, list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(logId) && isSignedIn() && (incoming().authorId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isValidId(logId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow delete: if isValidId(logId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
    }

    // Employees collection
    match /employees/{employeeId} {
      allow get, list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(employeeId) && isSignedIn() && (incoming().authorId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isValidId(employeeId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow delete: if isValidId(employeeId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
    }

    // Quotes collection
    match /quotes/{quoteId} {
      allow get, list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(quoteId) && isSignedIn() && (incoming().authorId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isValidId(quoteId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow delete: if isValidId(quoteId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
    }

    // APU Items collection
    match /apuItems/{itemId} {
      allow get, list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(itemId) && isSignedIn() && (incoming().authorId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isValidId(itemId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow delete: if isValidId(itemId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
    }

    // Schedule Tasks collection
    match /scheduleTasks/{taskId} {
      allow get, list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(taskId) && isSignedIn() && (incoming().authorId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isValidId(taskId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow delete: if isValidId(taskId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
    }

    // Milestones collection
    match /milestones/{milestoneId} {
      allow get, list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(milestoneId) && isSignedIn() && (incoming().authorId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isValidId(milestoneId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow delete: if isValidId(milestoneId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
    }

    // Task Reminders collection
    match /taskReminders/{reminderId} {
      allow get, list: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(reminderId) && isSignedIn() && (incoming().authorId == request.auth.uid || incoming().ownerId == request.auth.uid);
      allow update: if isValidId(reminderId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
      allow delete: if isValidId(reminderId) && isSignedIn() &&
        (existing().authorId == request.auth.uid || existing().ownerId == request.auth.uid);
    }
  }
}

