rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isOwned(data) {
      return isSignedIn() && data.keys().hasAny(['ownerId', 'authorId']) && (
        data.ownerId == request.auth.uid ||
        data.authorId == request.auth.uid
      );
    }

    function canCreate(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'client', 'budgetTotal', 'spentTotal', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 64 &&
        data.name is string && data.name.size() <= 200 &&
        data.client is string && data.client.size() <= 200 &&
        data.budgetTotal is number &&
        data.spentTotal is number &&
        data.status in ['En Ejecución', 'Planificación', 'Finalizado', 'Suspendido'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidFieldVisit(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'date', 'foremanName', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.projectName is string && data.projectName.size() <= 200 &&
        data.date is string && data.date.size() <= 30 &&
        data.foremanName is string && data.foremanName.size() <= 150 &&
        data.status in ['Autorizado', 'Pendiente', 'Revisión'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'projectId', 'date', 'category', 'amount', 'currency', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.category is string && data.category.size() <= 100 &&
        data.amount is number &&
        data.currency in ['GTQ', 'USD'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'projectId', 'date', 'employeeId', 'employeeName', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.employeeId is string && data.employeeId.size() <= 128 &&
        data.employeeName is string && data.employeeName.size() <= 150 &&
        data.status in ['Presente', 'Ausente', 'Permiso', 'Incapacidad IGSS'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(projectId) && isSignedIn() && canCreate(incoming()) && isValidProject(incoming());
      allow update: if isValidId(projectId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidProject(incoming());
      allow delete: if isValidId(projectId) && isSignedIn() && isOwned(existing());
    }

    match /fieldVisits/{visitId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(visitId) && isSignedIn() && canCreate(incoming()) && isValidFieldVisit(incoming());
      allow update: if isValidId(visitId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidFieldVisit(incoming());
      allow delete: if isValidId(visitId) && isSignedIn() && isOwned(existing());
    }

    match /expenses/{expenseId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(expenseId) && isSignedIn() && canCreate(incoming()) && isValidExpense(incoming());
      allow update: if isValidId(expenseId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidExpense(incoming());
      allow delete: if isValidId(expenseId) && isSignedIn() && isOwned(existing());
    }

    match /attendance/{attendanceId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(attendanceId) && isSignedIn() && canCreate(incoming()) && isValidAttendance(incoming());
      allow update: if isValidId(attendanceId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidAttendance(incoming());
      allow delete: if isValidId(attendanceId) && isSignedIn() && isOwned(existing());
    }

    function isValidMachinery(data) {
      return data.keys().hasAll(['id', 'name', 'model', 'plateOrCode', 'hourlyRateGTQ', 'currentHorometer', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 200 &&
        data.model is string && data.model.size() <= 200 &&
        data.plateOrCode is string && data.plateOrCode.size() <= 50 &&
        data.hourlyRateGTQ is number &&
        data.currentHorometer is number &&
        data.status in ['Disponible', 'En Obra', 'Mantenimiento'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidMachineryLog(data) {
      return data.keys().hasAll(['id', 'machineryId', 'machineryName', 'projectId', 'date', 'hoursWorked', 'operatorName', 'fuelGallons', 'costGTQ', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.machineryId is string && data.machineryId.size() <= 128 &&
        data.machineryName is string && data.machineryName.size() <= 200 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.hoursWorked is number &&
        data.operatorName is string && data.operatorName.size() <= 150 &&
        data.fuelGallons is number &&
        data.costGTQ is number &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'dailyRateGTQ', 'igssAffiliated', 'phone', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 200 &&
        data.role in ['Capataz', 'Albañil', 'Ayudante', 'Arquitecto Residente', 'Bodeguero', 'Electricista'] &&
        data.dailyRateGTQ is number &&
        data.igssAffiliated is bool &&
        data.phone is string && data.phone.size() <= 50 &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidQuote(data) {
      return data.keys().hasAll(['id', 'projectId', 'clientName', 'items', 'totalGTQ', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.clientName is string && data.clientName.size() <= 200 &&
        data.totalGTQ is number &&
        data.status in ['Aceptada', 'Enviada', 'Borrador', 'Rechazada'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    match /machinery/{machineryId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(machineryId) && isSignedIn() && canCreate(incoming()) && isValidMachinery(incoming());
      allow update: if isValidId(machineryId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidMachinery(incoming());
      allow delete: if isValidId(machineryId) && isSignedIn() && isOwned(existing());
    }

    match /machineryLogs/{logId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(logId) && isSignedIn() && canCreate(incoming()) && isValidMachineryLog(incoming());
      allow update: if isValidId(logId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidMachineryLog(incoming());
      allow delete: if isValidId(logId) && isSignedIn() && isOwned(existing());
    }

    match /employees/{employeeId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(employeeId) && isSignedIn() && canCreate(incoming()) && isValidEmployee(incoming());
      allow update: if isValidId(employeeId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidEmployee(incoming());
      allow delete: if isValidId(employeeId) && isSignedIn() && isOwned(existing());
    }

    match /quotes/{quoteId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(quoteId) && isSignedIn() && canCreate(incoming()) && isValidQuote(incoming());
      allow update: if isValidId(quoteId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidQuote(incoming());
      allow delete: if isValidId(quoteId) && isSignedIn() && isOwned(existing());
    }
    function isValidTaskReminder(data) {
      return data.keys().hasAll(['id', 'projectId', 'taskName', 'title', 'description', 'targetDate', 'advanceOption', 'priority', 'channel', 'enabled', 'createdAt', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.taskName is string && data.taskName.size() <= 200 &&
        data.title is string && data.title.size() <= 200 &&
        data.description is string && data.description.size() <= 500 &&
        data.targetDate is string && data.targetDate.size() <= 30 &&
        data.advanceOption in ['same_day', '1_day_before', '2_days_before', '3_days_before', '1_week_before', 'custom'] &&
        data.priority in ['Alta', 'Media', 'Baja'] &&
        data.channel in ['in_app', 'sound', 'email'] &&
        data.enabled is bool &&
        data.createdAt is string &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidCompanySettings(data) {
      return data.keys().hasAll(['id', 'legalName', 'commercialName', 'nit', 'architectName', 'architectColNumber', 'address', 'phone', 'email', 'exchangeRate', 'primaryColor', 'secondaryColor', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.legalName is string && data.legalName.size() <= 200 &&
        data.commercialName is string && data.commercialName.size() <= 200 &&
        data.nit is string && data.nit.size() <= 50 &&
        data.architectName is string && data.architectName.size() <= 200 &&
        data.architectColNumber is string && data.architectColNumber.size() <= 50 &&
        data.address is string && data.address.size() <= 300 &&
        data.phone is string && data.phone.size() <= 50 &&
        data.email is string && data.email.size() <= 200 &&
        data.exchangeRate is number &&
        data.primaryColor is string && data.primaryColor.size() <= 20 &&
        data.secondaryColor is string && data.secondaryColor.size() <= 20 &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }
    match /apuItems/{itemId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(itemId) && isSignedIn() && canCreate(incoming()) && isValidAPUItem(incoming());
      allow update: if isValidId(itemId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidAPUItem(incoming());
      allow delete: if isValidId(itemId) && isSignedIn() && isOwned(existing());
    }

    match /scheduleTasks/{taskId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(taskId) && isSignedIn() && canCreate(incoming()) && isValidScheduleTask(incoming());
      allow update: if isValidId(taskId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidScheduleTask(incoming());
      allow delete: if isValidId(taskId) && isSignedIn() && isOwned(existing());
    }

    match /milestones/{milestoneId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(milestoneId) && isSignedIn() && canCreate(incoming()) && isValidMilestone(incoming());
      allow update: if isValidId(milestoneId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidMilestone(incoming());
      allow delete: if isValidId(milestoneId) && isSignedIn() && isOwned(existing());
    }

    match /taskReminders/{reminderId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(reminderId) && isSignedIn() && canCreate(incoming()) && isValidTaskReminder(incoming());
      allow update: if isValidId(reminderId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidTaskReminder(incoming());
      allow delete: if isValidId(reminderId) && isSignedIn() && isOwned(existing());
    }

    match /companySettings/{settingsId} {
      allow get, list: if isSignedIn() && isOwned(resource.data);
      allow create: if isValidId(settingsId) && isSignedIn() && canCreate(incoming()) && isValidCompanySettings(incoming());
      allow update: if isValidId(settingsId) && isSignedIn() && isOwned(existing()) && canCreate(incoming()) && isValidCompanySettings(incoming());
      allow delete: if isValidId(settingsId) && isSignedIn() && isOwned(existing());
    }
  }
}
