rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnedByCurrentUser(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    function isLegacyOwnedByCurrentUser(data) {
      return isSignedIn() && data.keys().hasAny(['ownerId', 'authorId']) && (
        data.ownerId == request.auth.uid ||
        data.authorId == request.auth.uid
      );
    }

    // Validation helpers
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'client', 'budgetTotal', 'spentTotal', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 64 &&
        data.name is string && data.name.size() <= 200 &&
        data.client is string && data.client.size() <= 200 &&
        data.budgetTotal is number &&
        data.spentTotal is number &&
        data.status in ['En Ejecución', 'Planificación', 'Finalizado', 'Suspendido'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidFieldVisit(data) {
      return data.keys().hasAll(['id', 'projectId', 'projectName', 'date', 'foremanName', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.projectName is string && data.projectName.size() <= 200 &&
        data.date is string && data.date.size() <= 30 &&
        data.foremanName is string && data.foremanName.size() <= 150 &&
        data.status in ['Autorizado', 'Pendiente', 'Revisión'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'projectId', 'date', 'category', 'amount', 'currency', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.category is string && data.category.size() <= 100 &&
        data.amount is number &&
        data.currency in ['GTQ', 'USD'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'projectId', 'date', 'employeeId', 'employeeName', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.employeeId is string && data.employeeId.size() <= 128 &&
        data.employeeName is string && data.employeeName.size() <= 150 &&
        data.status in ['Presente', 'Ausente', 'Permiso', 'Incapacidad IGSS'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidCompanySettings(data) {
      return data.keys().hasAll(['legalName', 'commercialName', 'ownerId', 'authorId']) &&
        data.legalName is string && data.legalName.size() <= 250 &&
        data.commercialName is string && data.commercialName.size() <= 250 &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidMachinery(data) {
      return data.keys().hasAll(['id', 'name', 'model', 'plateOrCode', 'hourlyRateGTQ', 'currentHorometer', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 200 &&
        data.model is string && data.model.size() <= 200 &&
        data.plateOrCode is string && data.plateOrCode.size() <= 50 &&
        data.hourlyRateGTQ is number &&
        data.currentHorometer is number &&
        data.status in ['Disponible', 'En Obra', 'Mantenimiento'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidMachineryLog(data) {
      return data.keys().hasAll(['id', 'machineryId', 'machineryName', 'projectId', 'date', 'hoursWorked', 'operatorName', 'fuelGallons', 'costGTQ', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.machineryId is string && data.machineryId.size() <= 128 &&
        data.machineryName is string && data.machineryName.size() <= 200 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.hoursWorked is number &&
        data.operatorName is string && data.operatorName.size() <= 150 &&
        data.fuelGallons is number &&
        data.costGTQ is number &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'dailyRateGTQ', 'igssAffiliated', 'phone', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 150 &&
        data.role in ['Capataz', 'Albañil', 'Ayudante', 'Arquitecto Residente', 'Bodeguero', 'Electricista'] &&
        data.dailyRateGTQ is number &&
        data.igssAffiliated is boolean &&
        data.phone is string && data.phone.size() <= 50 &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidQuote(data) {
      return data.keys().hasAll(['id', 'projectId', 'clientName', 'clientNit', 'date', 'validUntil', 'items', 'totalGTQ', 'status', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.clientName is string && data.clientName.size() <= 200 &&
        data.clientNit is string && data.clientNit.size() <= 50 &&
        data.date is string && data.date.size() <= 30 &&
        data.validUntil is string && data.validUntil.size() <= 30 &&
        data.items is list &&
        data.totalGTQ is number &&
        data.status in ['Aceptada', 'Enviada', 'Borrador', 'Rechazada'] &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidAPUItem(data) {
      return data.keys().hasAll(['id', 'code', 'description', 'unit', 'quantity', 'materialUnitCostGTQ', 'laborUnitCostGTQ', 'equipmentUnitCostGTQ', 'totalUnitCostGTQ', 'totalPriceGTQ', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 64 &&
        data.description is string && data.description.size() <= 500 &&
        data.unit is string && data.unit.size() <= 50 &&
        data.quantity is number &&
        data.materialUnitCostGTQ is number &&
        data.laborUnitCostGTQ is number &&
        data.equipmentUnitCostGTQ is number &&
        data.totalUnitCostGTQ is number &&
        data.totalPriceGTQ is number &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidScheduleTask(data) {
      return data.keys().hasAll(['id', 'projectId', 'name', 'phase', 'startDate', 'endDate', 'progress', 'criticalPath', 'predecessors', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.name is string && data.name.size() <= 200 &&
        data.phase is string && data.phase.size() <= 100 &&
        data.startDate is string && data.startDate.size() <= 30 &&
        data.endDate is string && data.endDate.size() <= 30 &&
        data.progress is number &&
        data.criticalPath is boolean &&
        data.predecessors is list &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidMilestone(data) {
      return data.keys().hasAll(['id', 'projectId', 'title', 'phase', 'targetDate', 'completed', 'progress', 'weightPercent', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.phase is string && data.phase.size() <= 100 &&
        data.targetDate is string && data.targetDate.size() <= 30 &&
        data.completed is boolean &&
        data.progress is number &&
        data.weightPercent is number &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    function isValidTaskReminder(data) {
      return data.keys().hasAll(['id', 'projectId', 'taskName', 'title', 'description', 'targetDate', 'advanceOption', 'priority', 'channel', 'enabled', 'createdAt', 'ownerId', 'authorId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.projectId is string && data.projectId.size() <= 128 &&
        data.taskName is string && data.taskName.size() <= 200 &&
        data.title is string && data.title.size() <= 200 &&
        data.description is string && data.description.size() <= 1000 &&
        data.targetDate is string && data.targetDate.size() <= 30 &&
        data.advanceOption in ['same_day', '1_day_before', '2_days_before', '3_days_before', '1_week_before', 'custom'] &&
        data.priority in ['Alta', 'Media', 'Baja'] &&
        data.channel in ['in_app', 'sound', 'email'] &&
        data.enabled is boolean &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.ownerId == request.auth.uid &&
        data.authorId == request.auth.uid;
    }

    // Projects collection
    match /projects/{projectId} {
      allow get, list: if isSignedIn() && isOwnedByCurrentUser(resource.data);
      allow create: if isValidId(projectId) && isSignedIn() && isValidProject(incoming());
      allow update: if isValidId(projectId) && isSignedIn() && isOwnedByCurrentUser(existing()) && incoming().ownerId == request.auth.uid && incoming().authorId == request.auth.uid && isValidProject(incoming());
      allow delete: if isValidId(projectId) && isSignedIn() && isOwnedByCurrentUser(existing());
    }

    // Field visits collection
    match /fieldVisits/{visitId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.authorId == request.auth.uid);
      allow create: if isValidId(visitId) && isSignedIn() && isValidFieldVisit(incoming());
      allow update: if isValidId(visitId) && isSignedIn() && ((existing().ownerId == request.auth.uid) || (existing().authorId == request.auth.uid)) && incoming().ownerId == request.auth.uid && incoming().authorId == request.auth.uid && isValidFieldVisit(incoming());
      allow delete: if isValidId(visitId) && isSignedIn() && ((existing().ownerId == request.auth.uid) || (existing().authorId == request.auth.uid));
    }

    // Expenses collection
    match /expenses/{expenseId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.authorId == request.auth.uid);
      allow create: if isValidId(expenseId) && isSignedIn() && isValidExpense(incoming());
      allow update: if isValidId(expenseId) && isSignedIn() && ((existing().ownerId == request.auth.uid) || (existing().authorId == request.auth.uid)) && incoming().ownerId == request.auth.uid && incoming().authorId == request.auth.uid && isValidExpense(incoming());
      allow delete: if isValidId(expenseId) && isSignedIn() && ((existing().ownerId == request.auth.uid) || (existing().authorId == request.auth.uid));
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.authorId == request.auth.uid);
      allow create: if isValidId(attendanceId) && isSignedIn() && isValidAttendance(incoming());
      allow update: if isValidId(attendanceId) && isSignedIn() && ((existing().ownerId == request.auth.uid) || (existing().authorId == request.auth.uid)) && incoming().ownerId == request.auth.uid && incoming().authorId == request.auth.uid && isValidAttendance(incoming());
      allow delete: if isValidId(attendanceId) && isSignedIn() && ((existing().ownerId == request.auth.uid) || (existing().authorId == request.auth.uid));
    }

    // Company Settings collection
    match /companySettings/{settingId} {
      allow get, list: if isSignedIn() && isOwnedByCurrentUser(resource.data);
      allow create: if isValidId(settingId) && isSignedIn() && isValidCompanySettings(incoming());
      allow update: if isValidId(settingId) && isSignedIn() && isOwnedByCurrentUser(existing()) && incoming().ownerId == request.auth.uid && incoming().authorId == request.auth.uid && isValidCompanySettings(incoming());
      allow delete: if isValidId(settingId) && isSignedIn() && isOwnedByCurrentUser(existing());
    }

    // Machinery collection
    match /machinery/{machineryId} {
      allow get, list: if isSignedIn() && isLegacyOwnedByCurrentUser(resource.data);
      allow create: if isValidId(machineryId) && isSignedIn() && isValidMachinery(incoming());
      allow update: if isValidId(machineryId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing()) && isValidMachinery(incoming());
      allow delete: if isValidId(machineryId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing());
    }

    // Machinery Logs collection
    match /machineryLogs/{logId} {
      allow get, list: if isSignedIn() && isLegacyOwnedByCurrentUser(resource.data);
      allow create: if isValidId(logId) && isSignedIn() && isValidMachineryLog(incoming());
      allow update: if isValidId(logId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing()) && isValidMachineryLog(incoming());
      allow delete: if isValidId(logId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing());
    }

    // Employees collection
    match /employees/{employeeId} {
      allow get, list: if isSignedIn() && isLegacyOwnedByCurrentUser(resource.data);
      allow create: if isValidId(employeeId) && isSignedIn() && isValidEmployee(incoming());
      allow update: if isValidId(employeeId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing()) && isValidEmployee(incoming());
      allow delete: if isValidId(employeeId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing());
    }

    // Quotes collection
    match /quotes/{quoteId} {
      allow get, list: if isSignedIn() && isLegacyOwnedByCurrentUser(resource.data);
      allow create: if isValidId(quoteId) && isSignedIn() && isValidQuote(incoming());
      allow update: if isValidId(quoteId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing()) && isValidQuote(incoming());
      allow delete: if isValidId(quoteId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing());
    }

    // APU Items collection
    match /apuItems/{itemId} {
      allow get, list: if isSignedIn() && isLegacyOwnedByCurrentUser(resource.data);
      allow create: if isValidId(itemId) && isSignedIn() && isValidAPUItem(incoming());
      allow update: if isValidId(itemId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing()) && isValidAPUItem(incoming());
      allow delete: if isValidId(itemId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing());
    }

    // Schedule Tasks collection
    match /scheduleTasks/{taskId} {
      allow get, list: if isSignedIn() && isLegacyOwnedByCurrentUser(resource.data);
      allow create: if isValidId(taskId) && isSignedIn() && isValidScheduleTask(incoming());
      allow update: if isValidId(taskId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing()) && isValidScheduleTask(incoming());
      allow delete: if isValidId(taskId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing());
    }

    // Milestones collection
    match /milestones/{milestoneId} {
      allow get, list: if isSignedIn() && isLegacyOwnedByCurrentUser(resource.data);
      allow create: if isValidId(milestoneId) && isSignedIn() && isValidMilestone(incoming());
      allow update: if isValidId(milestoneId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing()) && isValidMilestone(incoming());
      allow delete: if isValidId(milestoneId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing());
    }

    // Task Reminders collection
    match /taskReminders/{reminderId} {
      allow get, list: if isSignedIn() && isLegacyOwnedByCurrentUser(resource.data);
      allow create: if isValidId(reminderId) && isSignedIn() && isValidTaskReminder(incoming());
      allow update: if isValidId(reminderId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing()) && isValidTaskReminder(incoming());
      allow delete: if isValidId(reminderId) && isSignedIn() && isLegacyOwnedByCurrentUser(existing());
    }
  }
}

